rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Catálogo: lectura pública, escritura solo admin (custom claim admin)
    match /products/{id} { allow read: if true; allow write: if request.auth.token.admin == true; }
    match /categories/{id} { allow read: if true; allow write: if request.auth.token.admin == true; }
    // Pedidos: el cliente solo puede CREAR (validado); leer/editar solo admin
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['customer','items','total','paymentMethod','orderStatus'])
        && request.resource.data.orderStatus == 'Pendiente'
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30;
      allow read, update, delete: if request.auth.token.admin == true;
    }
  }
}
